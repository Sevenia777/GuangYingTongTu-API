# Atlas Cluster0 connection string. URL-encode special characters in the password.
MONGO_CONNECTION_STRING=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
Mongo__DatabaseName=GuangYingTongTu
Mongo__UsersCollectionName=users

# Generate with: openssl rand -base64 48
JWT_KEY=replace-with-at-least-32-random-characters
Jwt__Issuer=GuangYingTongTu.Api
Jwt__Audience=GuangYingTongTu.Unity
Jwt__ExpirationMinutes=720

# Optional first-run accounts. The hashes are created automatically with BCrypt.
Bootstrap__AdminUsername=admin
Bootstrap__AdminPassword=replace-with-a-strong-admin-password
Bootstrap__VipUsername=vip_demo
Bootstrap__VipPassword=replace-with-a-strong-vip-password
